 }
 
+/**
+ * rockchip_iommu_reset() - Restore paging for a quiesced Rockchip master
+ * @dev: master attached to a Rockchip paging domain
+ *
+ * The caller must stop every master sharing this IOMMU, disable its IRQs,
+ * and serialize domain attachment and recovery. This function may sleep.
+ * It preserves the page tables and reports clock and MMU handshake failures.
+ *
+ * Return: zero on success, or a negative error on recovery failure.
+ */
+int rockchip_iommu_reset(struct device *dev)
+{
+	struct rk_iommu_domain *rk_domain;
+	struct rk_iommu *iommu;
+	int ret, err, i;
+	u32 auto_gate;
+
+	if (!dev)
+		return -ENODEV;
+	iommu = rk_iommu_from_dev(dev);
+
+	if (!iommu || !iommu->domain ||
+	    iommu->domain == &rk_identity_domain)
+		return -ENODEV;
+
+	ret = pm_runtime_resume_and_get(iommu->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = clk_bulk_enable(iommu->num_clocks, iommu->clocks);
+	if (ret)
+		goto out_pm;
+
+	for (i = 0; i < iommu->num_mmu; i++)
+		rk_iommu_write(iommu->bases[i], RK_MMU_INT_MASK, 0);
+
+	ret = rk_iommu_enable_stall(iommu);
+	if (ret)
+		goto out_stall;
+	ret = rk_iommu_disable_paging(iommu);
+	if (ret)
+		goto out_stall;
+	ret = rk_iommu_force_reset(iommu);
+	if (ret)
+		goto out_stall;
+
+	rk_domain = to_rk_domain(iommu->domain);
+	for (i = 0; i < iommu->num_mmu; i++) {
+		rk_iommu_write(iommu->bases[i], RK_MMU_DTE_ADDR,
+			       iommu->rk_ops->mk_dtentries(rk_domain->dt_dma));
+		rk_iommu_base_command(iommu->bases[i], RK_MMU_CMD_ZAP_CACHE);
+		auto_gate = rk_iommu_read(iommu->bases[i], RK_MMU_AUTO_GATING);
+		auto_gate |= DISABLE_FETCH_DTE_TIME_LIMIT;
+		rk_iommu_write(iommu->bases[i], RK_MMU_AUTO_GATING, auto_gate);
+	}
+	ret = rk_iommu_enable_paging(iommu);
+
+out_stall:
+	err = rk_iommu_disable_stall(iommu);
+	if (!ret)
+		ret = err;
+	if (!ret)
+		for (i = 0; i < iommu->num_mmu; i++)
+			rk_iommu_write(iommu->bases[i], RK_MMU_INT_MASK, RK_MMU_IRQ_MASK);
+	clk_bulk_disable(iommu->num_clocks, iommu->clocks);
+out_pm:
+	pm_runtime_put(iommu->dev);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rockchip_iommu_reset);
+
+/**
+ * rockchip_iommu_mask_irq() - Mask a Rockchip master's MMU fault interrupts
+ * @dev: master whose active fault handler is being called
+ *
+ * Only call from the domain fault callback in rk_iommu_irq(), which holds
+ * the runtime PM and clock references required for register access.
+ */
+void rockchip_iommu_mask_irq(struct device *dev)
+{
+	struct rk_iommu *iommu;
+	int i;
+
+	if (WARN_ON_ONCE(!dev))
+		return;
+	iommu = rk_iommu_from_dev(dev);
+	if (WARN_ON_ONCE(!iommu))
+		return;
+
+	for (i = 0; i < iommu->num_mmu; i++)
+		rk_iommu_write(iommu->bases[i], RK_MMU_INT_MASK, 0);
+}
+EXPORT_SYMBOL_GPL(rockchip_iommu_mask_irq);
+
 static struct iommu_domain *rk_iommu_domain_alloc_paging(struct device *dev)
 {
 	struct rk_iommu_domain *rk_domain;
diff --git a/include/soc/rockchip/rockchip_iommu.h b/include/soc/rockchip/rockchip_iommu.h
new file mode 100644
--- /dev/null
+++ b/include/soc/rockchip/rockchip_iommu.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ROCKCHIP_IOMMU_RECOVERY_H
+#define ROCKCHIP_IOMMU_RECOVERY_H
+
+struct device;
+
+/* The caller must quiesce its engine and disable the IOMMU IRQ first. */
+int rockchip_iommu_reset(struct device *dev);
+
+/* For a fault callback invoked with the IOMMU clocks already enabled. */
+void rockchip_iommu_mask_irq(struct device *dev);
+
+#endif
diff --git a/arch/arm64/boot/dts/rockchip/rk3576-vepu510-mpp.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-vepu510-mpp.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-vepu510-mpp.dtsi
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/* Experimental single-core MPP encoder integration for mainline RK3576. */
+
+#include <dt-bindings/clock/rockchip,rk3576-cru.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/power/rockchip,rk3576-power.h>
+#include <dt-bindings/reset/rockchip,rk3576-cru.h>
+
+/ {
+	mpp_srv: mpp-srv {
+		compatible = "rockchip,mpp-service";
+		rockchip,taskqueue-count = <1>;
+		rockchip,resetgroup-count = <1>;
+	};
+
+	rkvenc0: video-codec@27a00000 {
+		compatible = "rockchip,rkv-encoder-rk3576";
+		reg = <0x0 0x27a00000 0x0 0x6000>;
+		interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "irq_vepu0";
+		clocks = <&cru ACLK_VEPU0>, <&cru HCLK_VEPU0>,
+			 <&cru CLK_VEPU0_CORE>;
+		clock-names = "aclk_vcodec", "hclk_vcodec", "clk_core";
+		/* Fixed bring-up clocks; vendor OPP/DVFS is not enabled. */
+		assigned-clocks = <&cru ACLK_VEPU0_ROOT>,
+				  <&cru HCLK_VEPU0_ROOT>, <&cru CLK_VEPU0_CORE>;
+		assigned-clock-rates = <200000000>, <100000000>, <200000000>;
+		resets = <&cru SRST_A_VEPU0>, <&cru SRST_H_VEPU0>,
+			 <&cru SRST_VEPU0_CORE>;
+		reset-names = "video_a", "video_h", "video_core";
+		iommus = <&rkvenc0_mmu>;
+		power-domains = <&power RK3576_PD_VEPU0>;
+		rockchip,srv = <&mpp_srv>;
+		rockchip,taskqueue-node = <0>;
+		rockchip,resetgroup-node = <0>;
+		rockchip,task-capacity = <8>;
+	};
+
+	rkvenc0_mmu: iommu@27a0f000 {
+		compatible = "rockchip,rk3576-iommu", "rockchip,rk3568-iommu";
+		reg = <0x0 0x27a0f000 0x0 0x40>;
+		interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VEPU0>, <&cru HCLK_VEPU0>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		rockchip,disable-mmu-reset;
+		power-domains = <&power RK3576_PD_VEPU0>;
+	};
+};
