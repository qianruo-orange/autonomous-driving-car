[Unit]
Description=PulseAudio (system mode) - Bluetooth A2DP/HFP endpoints for BlueZ
Documentation=https://www.freedesktop.org/wiki/Software/PulseAudio/
After=bluetooth.target sound.target
Wants=bluetooth.target

[Service]
Type=simple
ExecStart=/usr/bin/pulseaudio --system --disallow-exit --exit-idle-time=-1 --daemonize=no --log-target=journal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
