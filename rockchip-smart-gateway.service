[Unit]
Description=Rockchip Smart Gateway Service (CAN FD / TCP / Video / AI)
After=network.target

[Service]
Type=notify
NotifyAccess=all

WorkingDirectory=/opt/rockchip-smart-gateway
ExecStart=/opt/rockchip-smart-gateway/bin/rockchip-smart-gateway

WatchdogSec=10
Restart=on-failure
RestartSec=5
TimeoutStartSec=15

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/rockchip-smart-gateway/logs /opt/rockchip-smart-gateway/config /opt/rockchip-smart-gateway/recordings
ReadOnlyPaths=/opt/rockchip-smart-gateway/html

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rockchip-smart-gateway

[Install]
WantedBy=multi-user.target
