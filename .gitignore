compile_flags.txt
*.code-workspace

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
# 运行时/设备专属配置与生成物（不应入库，避免每次构建/部署产生噪音）
